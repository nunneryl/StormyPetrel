# Required — Supabase connection. Server components use the service key,
# so it MUST stay server-only (no NEXT_PUBLIC_ prefix). Never commit a
# real key.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here

# Optional — public-facing canonical URL. Used to build absolute URLs in
# robots.txt, sitemap.xml, OpenGraph metadata, and canonical links.
# Defaults to https://stormypetrel.surf when unset.
NEXT_PUBLIC_SITE_URL=https://stormypetrel.surf

# Optional — CARTO basemaps key for the /map tiles (free: carto.com/basemaps/apikey).
# Public by design (it rides on every tile URL), so restrict it to the site's
# domains in the CARTO dashboard. Inlined at build time: redeploy after setting.
# Unset, /map falls back to OpenStreetMap's standard tiles.
NEXT_PUBLIC_CARTO_BASEMAPS_KEY=
